  howToPlayGroup: {fileID: 300692536}
  npcSequences:
  - scenarioIndex: 5
    npcParent: {fileID: 699606827}
    npcAnimator: {fileID: 717870237}
    npcDialogueBubble: {fileID: 572684918}
    callAnimationName: Idle
    dialogueCebuano: Rodrick! Ari diri!
    dialogueIlokano: Rodrick! Umay ditoy!
    managedExternally: 0
    skipCalloutDialogue: 0
    keepActiveAfterSuccess: 0
    successConversation:
    - isNPC: 1
      textEnglish: Here's the vegetables Nida bought in advance!
      textCebuano: 
      textIlokano: 
      animationToPlay: 
      triggerInflateNPCNext: 0
    - isNPC: 0
      textEnglish: Thank you Aling Riza! I'll make sure to give it to her.
      textCebuano: 
      textIlokano: 
      animationToPlay: 
      triggerInflateNPCNext: 0
    - isNPC: 1
      textEnglish: 
      textCebuano: Take care on your way, paalam!
      textIlokano: Take care on your way, agpakada akon
      animationToPlay: 
      triggerInflateNPCNext: 0
    walkBeforeConversation: 1
    conversationZoom: 0
    conversationYOffset: 0
    conversationNpcPull: 0.35
    originalScale: {x: 0, y: 0, z: 0}
  - scenarioIndex: 9
    npcParent: {fileID: 94787121}
    npcAnimator: {fileID: 1878326760}
    npcDialogueBubble: {fileID: 1307937208}
    callAnimationName: Idle
    dialogueCebuano: Rodrick, you brought the candles. Salamat anak. 'v', kukuha
      lang ako ng resibo.
    dialogueIlokano: Rodrick, you brought the candles. Agyamanak. 'Uray ditoy', kukuha
      lang ako ng resibo.
    managedExternally: 0
    skipCalloutDialogue: 0
    keepActiveAfterSuccess: 0
    successConversation:
    - isNPC: 1
      textEnglish: 
      textCebuano: Here's the receipt, anak. Salamat muli.
      textIlokano: Here's the receipt, anak. Agyamanak.
      animationToPlay: 
      triggerInflateNPCNext: 0
    - isNPC: 0
      textEnglish: You're welcome father. Have a good day
      textCebuano: 
      textIlokano: 
      animationToPlay: 
      triggerInflateNPCNext: 0
    walkBeforeConversation: 0
    conversationZoom: 0
    conversationYOffset: 0
    conversationNpcPull: 0.35
    originalScale: {x: 0, y: 0, z: 0}
  - scenarioIndex: 14
    npcParent: {fileID: 1846781106}
    npcAnimator: {fileID: 1278533064}
    npcDialogueBubble: {fileID: 29827655}
    callAnimationName: Sleeping
    dialogueCebuano: 
    dialogueIlokano: 
    managedExternally: 1
    skipCalloutDialogue: 0
    keepActiveAfterSuccess: 0
    successConversation:
    - isNPC: 0
      textEnglish: Manong Ronnie! Wake up!
      textCebuano: Manong Ronnie! Bangon na!
      textIlokano: Manong Ronnie! Agbangon ka!
      animationToPlay: 
      triggerInflateNPCNext: 0
    - isNPC: 1
      textEnglish: Hah?! Who?... Ay, Rodrick. I fell asleep for a second..
      textCebuano: Ha?! Kinsa?... Ay, ikaw diay Rodrick. Nakatulog lang ko gamay.
      textIlokano: Hah?! Sino?... Ay, Rodrick ka laeng. Natulog laeng idi bassit.
      animationToPlay: Awake
      triggerInflateNPCNext: 0
    - isNPC: 0
      textEnglish: Do you know how to get to the Barangay Hall?
      textCebuano: 
      textIlokano: 
      animationToPlay: 
      triggerInflateNPCNext: 0
    - isNPC: 1
      textEnglish: Oh! Neneng can help you get there! Follow her.
      textCebuano: 
      textIlokano: 
      animationToPlay: 
      triggerInflateNPCNext: 1
    walkBeforeConversation: 1
    conversationZoom: 2.7
    conversationYOffset: -100
    conversationNpcPull: 0.413
    originalScale: {x: 0, y: 0, z: 0}
