  m_Script: {fileID: 11500000, guid: 6cb5b2feec328c3479bc37cc1e4f5804, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ReactionCardsManager
  jsonFileName: Gratitude
  imageMappings:
  - situationText: Someone handed you a pencil that you dropped. Express normal gratitude.
    cardImage: {fileID: 21300000, guid: 3c7231b7669869c408b662816266cce2, type: 3}
  - situationText: Your neighbor spent 5 hours helping you fix your broken roof.
      Express extreme gratitude!
    cardImage: {fileID: 21300000, guid: 6282ce5f09f1247419ba4a43b9bc35c8, type: 3}
  - situationText: You are trying to pass through a crowded market and someone is
      blocking your way. What do you say?
    cardImage: {fileID: 21300000, guid: ee0469f6245f8cd448be497d7d5b9f01, type: 3}
  - situationText: A kind stranger helped you carry your heavy bags all the way to
      the bus station. Thank them specifically for their help!
    cardImage: {fileID: 21300000, guid: a5235ecc44a1814489537e3fcf2dfda2, type: 3}
  - situationText: You accidentally stepped on your friend's foot! You should apologize.
    cardImage: {fileID: 21300000, guid: e7e2aeb24f8bc004486bf304e8ff2a6a, type: 3}
  - situationText: The vendor gave you your change after you bought some candy. Express
      normal gratitude.
    cardImage: {fileID: 21300000, guid: 621e363f204394843a372541fe919a33, type: 3}
  - situationText: Your teacher gave you a very beautiful and expensive book as an
      award. Express extreme gratitude!
    cardImage: {fileID: 21300000, guid: 46a5052f93af34d4abcb431d371bd8fb, type: 3}
  - situationText: You need to ask the busy vendor a question, but they are looking
      away. Get their attention politely.
    cardImage: {fileID: 21300000, guid: 0a4de48c6c6d8f84faf1ee8c963746d4, type: 3}
  - situationText: Your classmate helped you solve a very hard math problem. Thank
      them specifically for their help!
    cardImage: {fileID: 21300000, guid: 76819c58ffa4ece44a629e52d4bbdb06, type: 3}
  - situationText: You accidentally knocked over your Lola's glass of water. You
      should apologize!
    cardImage: {fileID: 21300000, guid: 89994b35e67d1864d9f394b51cba78d7, type: 3}
  - situationText: '[MEMORY] You wake up and see the sun shining. Greet your family
      for the start of the day!'
    cardImage: {fileID: 21300000, guid: b83bd6892e0b43d448957e218ba8f33d, type: 3}
  - situationText: '[MEMORY] You meet a new friend and want to ask about their well-being.
      What do you say?'
    cardImage: {fileID: 21300000, guid: f011e184348a4664db84dbcb1c8a28bc, type: 3}
  - situationText: '[MEMORY] Your friend asks ''How are you?''. You are feeling great.
      How do you respond?'
    cardImage: {fileID: 21300000, guid: e055d73952cdd3447b4b6659aa63ad4b, type: 3}
  - situationText: '[MEMORY] It is 7:00 PM and the moon is out. Greet your neighbor!'
    cardImage: {fileID: 21300000, guid: 8679d02c01c81db4e89a31a1716fd6b4, type: 3}
  - situationText: '[MEMORY] The school bell rings and it is time to go home. What
      do you say to your teacher?'
    cardImage: {fileID: 21300000, guid: f03c4a428fa886b4ab522129476b8b76, type: 3}
