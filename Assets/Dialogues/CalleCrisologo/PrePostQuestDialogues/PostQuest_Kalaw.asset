  speakerName: Kalaw
  speakerPortrait: {fileID: 21300000, guid: e9a1f2822809deb49a0ce098da0fddca, type: 3}
  dialogueText: "Squawk! Look at you, traveler! The crystal is glowing brighter than
    the midday sun over Calle Crisologo! You didn't just learn words\u2014you opened
    doors, shared smiles, and made real friends with the people of Ilocos. Remember:
    a language is a bridge. Keep listening, keep speaking, and never stop connecting!
    Squawk!"
